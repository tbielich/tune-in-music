[Unit]
Description=tune-in-music mpv daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
EnvironmentFile=-/etc/default/tune-in-music-mpv
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/bin/sh -c 'exec mpv \
  --idle=yes \
  --fullscreen \
  --vo=gpu \
  --gpu-context=drm \
  --input-ipc-server=/tmp/mpv.sock \
  --cache=yes --cache-secs=30 \
  --demuxer-max-bytes=400M \
  --demuxer-max-back-bytes=200M \
  --hwdec=auto \
  --vd-lavc-threads=2 \
  --no-border \
  --ontop \
  --really-quiet \
  --ao=alsa \
  ${MPV_AUDIO_DEVICE:+--audio-device=${MPV_AUDIO_DEVICE}}'
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
