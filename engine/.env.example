HOST=0.0.0.0
PORT=3030
TV_CHANNEL=spotify
# Prefer H.264 (avc1): the Raspberry Pi 4 hardware-decodes it. AV1/VP9 have no HW
# decoder on the Pi 4 and result in audio-only / black video.
TV_FORMAT=bestvideo[vcodec^=avc1][height<=720]+bestaudio/best[vcodec^=avc1][height<=720]/best[ext=mp4]/best
MPV_SOCKET=/tmp/mpv.sock
YTDLP_BIN=yt-dlp
MPV_BIN=mpv
ENABLE_MEDIA_KEYS=0

# Spotify playlist URL (used when TV_CHANNEL=spotify)
SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/1o6pxgjA5affQmUdRSIVuh
SPOTIFY_REFRESH_MINUTES=15

# Optional (Pi only)
MPV_AUDIO_DEVICE=
MPV_DRM_CONNECTOR=
